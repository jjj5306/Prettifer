{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/composition/**/*.ts",
    "src/git/**/*.ts",
    "src/history/**/*.ts"
  ],
  "exclude": ["src/desktop/**/*.ts", "src/desktop/**/*.tsx", "test/**/*.ts"]
}
