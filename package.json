{
  "name": "prettifer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": ".webpack/main",
  "scripts": {
    "build": "npm run build:core && npm run desktop:package",
    "build:core": "tsc -p tsconfig.build.json",
    "desktop:start": "electron-forge start",
    "desktop:package": "electron-forge package",
    "desktop:make": "electron-forge make --platform=win32",
    "lint": "eslint .",
    "test": "vitest run",
    "test:desktop": "npm run test:desktop:unit && npm run test:desktop:e2e",
    "test:desktop:unit": "vitest run test/desktop",
    "test:desktop:e2e": "electron-forge package && playwright test --config=playwright.electron.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.desktop.shared.json && tsc --noEmit -p tsconfig.desktop.main.json && tsc --noEmit -p tsconfig.desktop.preload.json && tsc --noEmit -p tsconfig.desktop.renderer.json"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "overrides": {
    "dompurify": "3.4.12",
    "tar": "7.5.21",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "dependencies": {
    "monaco-editor": "0.56.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/plugin-base": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "css-loader": "7.1.4",
    "electron": "43.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "monaco-editor-webpack-plugin": "7.1.1",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10",
    "webpack": "5.108.4"
  }
}
